# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SUMMARIZATION_MODEL=gemini-2.5-flash
GEMINI_TRANSLATION_MODEL=gemini-1.5-flash

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@your_channel_name

# Database - Neon Postgres (recommended for production)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database - SQLite (for local development, leave DATABASE_URL empty)
# DATABASE_URL=
# DATABASE_PATH=data/brief.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Scheduling
DAILY_PUBLISH_TIME=06:00

# Retry settings
MAX_RETRIES_PER_MODEL=2
REQUEST_TIMEOUT_SECONDS=30

# Content filtering
MIN_QUALITY_SCORE=0.7
TOP_STORIES_COUNT=5
